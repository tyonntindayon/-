import math
import random

import pyxel

WIDTH = 160
HEIGHT = 120

BASE_PADDLE_W = 28
GIANT_PADDLE_W = 38
MAX_HEARTS = 3
INITIAL_BALL_SPEED = 1.7
MAX_BALL_SPEED = 7.0

# Soft, eye-friendly palette
PALETTE = [
    0x0f172a,  # 0 dark navy (bg)
    0x1e293b,  # 1 panel dark
    0x334155,  # 2 muted blue
    0x475569,  # 3 slate
    0x64748b,  # 4 cool gray
    0x93c5fd,  # 5 soft sky
    0xbfe3ff,  # 6 pale blue
    0xcbd5e1,  # 7 light gray
    0xf9a8d4,  # 8 blush pink
    0xfcd34d,  # 9 warm yellow
    0x86efac,  # 10 mint green
    0x67e8f9,  # 11 cyan
    0xfbbf24,  # 12 amber
    0xfda4af,  # 13 rose
    0xfef3c7,  # 14 cream
    0xf8fafc,  # 15 white
]

for i, color in enumerate(PALETTE):
    pyxel.colors[i] = color

pyxel.init(WIDTH, HEIGHT, title="DOPABALL - gentle mode")
pyxel.mouse(True)

# Global state
paddle_x = 55.0
paddle_y = 100
paddle_w = BASE_PADDLE_W

ball_x = 70.0
ball_y = 55.0
ball_dx = 0.0
ball_dy = -1.0
ball_speed = INITIAL_BALL_SPEED
ball_attached = True

score = 0
high_score = 0
combo = 0
hearts = MAX_HEARTS
flash_timer = 0
particles = []
score_popups = []
start_delay = 0
game_over = False


def clamp(value, lo, hi):
    return max(lo, min(hi, value))


def make_particles(x, y, amount=12, color=None):
    for _ in range(amount):
        angle = random.uniform(0, math.tau)
        speed = random.uniform(0.8, 2.8)
        color_value = color if color is not None else random.randint(5, 15)
        particles.append([
            float(x),
            float(y),
            math.cos(angle) * speed,
            math.sin(angle) * speed,
            random.randint(10, 28),
            color_value,
        ])


def add_score_popup(x, y, points):
    score_popups.append({
        "x": float(x),
        "y": float(y),
        "text": "+%d" % points,
        "timer": 36,
        "color": 11,
    })


def award_hit():
    global score, combo, high_score, ball_speed, flash_timer

    combo += 1
    score += 10 + combo * 2
    high_score = max(high_score, score)
    flash_timer = 2

    ball_speed = min(MAX_BALL_SPEED, ball_speed + 0.06)
    make_particles(ball_x, ball_y, 16, 11)
    add_score_popup(ball_x, ball_y, 10 + combo * 2)


def lose_heart():
    global hearts, game_over, ball_attached, combo, paddle_w

    if hearts <= 0:
        game_over = True
        return

    hearts -= 1
    combo = 0
    ball_attached = True
    paddle_w = BASE_PADDLE_W

    if hearts <= 0:
        game_over = True

    make_particles(ball_x, ball_y, 24, 8)


def reset():
    global paddle_x, paddle_y, paddle_w
    global ball_x, ball_y, ball_dx, ball_dy, ball_speed
    global ball_attached, score, combo, hearts, flash_timer
    global particles, score_popups, game_over, start_delay

    paddle_x = 55.0
    paddle_y = 100
    paddle_w = BASE_PADDLE_W

    ball_x = 70.0
    ball_y = 55.0
    ball_dx = 0.0
    ball_dy = -1.0
    ball_speed = INITIAL_BALL_SPEED
    ball_attached = True

    score = 0
    combo = 0
    hearts = MAX_HEARTS
    flash_timer = 0
    particles = []
    score_popups = []
    game_over = False
    start_delay = 30


def launch_ball():
    global ball_dx, ball_dy, ball_attached
    angle = random.uniform(-0.8, 0.8)
    ball_dx = math.sin(angle)
    ball_dy = -abs(math.cos(angle))
    ball_attached = False


def draw_logo(x, y, text, scale=2, color=15):
    font = {
        "D": ["1110", "1001", "1001", "1001", "1110"],
        "O": ["0110", "1001", "1001", "1001", "0110"],
        "P": ["1110", "1001", "1110", "1000", "1000"],
        "A": ["0110", "1001", "1111", "1001", "1001"],
        "B": ["1110", "1001", "1110", "1001", "1110"],
        "L": ["1000", "1000", "1000", "1000", "1111"],
    }

    cursor_x = x
    for ch in text:
        if ch not in font:
            continue
        pattern = font[ch]
        for row, line in enumerate(pattern):
            for col, bit in enumerate(line):
                if bit == "1":
                    pyxel.rect(cursor_x + col * scale, y + row * scale, scale, scale, color)
        cursor_x += 5 * scale


def draw_hearts():
    for i in range(MAX_HEARTS):
        x = 8 + i * 12
        y = 6
        fill = i < hearts
        pyxel.rect(x + 1, y, 3, 2, 8 if fill else 4)
        pyxel.rect(x + 6, y, 3, 2, 8 if fill else 4)
        pyxel.rect(x, y + 1, 10, 3, 8 if fill else 4)
        pyxel.rect(x + 1, y + 4, 8, 2, 8 if fill else 4)
        pyxel.rect(x + 2, y + 6, 6, 2, 8 if fill else 4)
        pyxel.rect(x + 3, y + 8, 4, 1, 8 if fill else 4)

        if not fill:
            pyxel.rect(x + 3, y + 2, 4, 3, 0)
            pyxel.pset(x + 2, y + 1, 0)
            pyxel.pset(x + 7, y + 1, 0)
            pyxel.rect(x + 3, y + 5, 4, 2, 0)
            pyxel.rect(x + 4, y + 7, 2, 1, 0)


def draw_hud():
    pyxel.rectb(0, 0, WIDTH, 12, 7)
    pyxel.text(92, 4, "SCORE", 7)
    pyxel.text(120, 4, str(score), 15)
    pyxel.text(8, 4, "BEST", 7)
    pyxel.text(30, 4, str(high_score), 15)
    draw_hearts()


def draw_particles():
    for x, y, dx, dy, life, color in particles:
        pyxel.pset(int(x), int(y), color)


def draw_popups():
    for popup in score_popups:
        pyxel.text(int(popup["x"]), int(popup["y"]), popup["text"], popup["color"])


def draw_title_screen():
    pyxel.cls(0)
    for i in range(12):
        x = (i * 19 + pyxel.frame_count) % WIDTH
        pyxel.line(x, 0, x - 20, HEIGHT, 2)

    draw_logo(18, 10, "DOPA", 3, 11)
    draw_logo(18, 26, "BALL", 3, 15)

    pyxel.rect(12, 48, 136, 42, 1)
    pyxel.rectb(12, 48, 136, 42, 6)
    pyxel.text(30, 58, "Eye-friendly mode", 7)
    pyxel.text(24, 68, "click or space to start", 11)
    pyxel.text(36, 80, "best score: %d" % high_score, 15)
    pyxel.text(28, 92, "gentle pastel theme", 10)


def draw_game_screen():
    pyxel.cls(0)
    pyxel.rect(0, 0, WIDTH, 12, 1)
    draw_hud()

    pyxel.rect(0, 12, WIDTH, 1, 7)
    pyxel.line(0, 12, WIDTH, 12, 7)

    # Walls and floor
    pyxel.rectb(0, 12, WIDTH, 108, 7)
    pyxel.rect(0, 118, WIDTH, 2, 1)

    # Paddle
    pyxel.rect(int(paddle_x), int(paddle_y), int(paddle_w), 5, 11)
    pyxel.rectb(int(paddle_x), int(paddle_y), int(paddle_w), 5, 15)

    # Ball
    pyxel.circ(int(ball_x), int(ball_y), 2, 15)
    pyxel.circ(int(ball_x), int(ball_y), 1, 11)

    # Extra attention when near game over
    if flash_timer > 0:
        pyxel.rect(0, 0, WIDTH, HEIGHT, 12)

    draw_particles()
    draw_popups()

    if game_over:
        pyxel.rect(18, 42, 124, 26, 1)
        pyxel.rectb(18, 42, 124, 26, 8)
        pyxel.text(54, 49, "GAME OVER", 13)
        pyxel.text(46, 58, "press R to retry", 15)


def draw():
    if not game_over:
        draw_game_screen()
    else:
        draw_game_screen()


def update():
    global paddle_x, paddle_w, ball_x, ball_y, ball_dx, ball_dy, ball_speed
    global flash_timer, combo, start_delay, game_over

    if start_delay > 0:
        start_delay -= 1

    if flash_timer > 0:
        flash_timer -= 1

    for particle in particles[:]:
        particle[0] += particle[2]
        particle[1] += particle[3]
        particle[4] -= 1
        if particle[4] <= 0:
            particles.remove(particle)

    for popup in score_popups[:]:
        popup["y"] -= 0.35
        popup["timer"] -= 1
        if popup["timer"] <= 0:
            score_popups.remove(popup)

    if pyxel.btn(pyxel.KEY_LEFT) or pyxel.btn(pyxel.KEY_A):
        paddle_x -= 2.2
    if pyxel.btn(pyxel.KEY_RIGHT) or pyxel.btn(pyxel.KEY_D):
        paddle_x += 2.2

    if pyxel.btn(pyxel.MOUSE_BUTTON_LEFT):
        paddle_x = pyxel.mouse_x - paddle_w / 2

    paddle_x = clamp(paddle_x, 0, WIDTH - paddle_w)

    if pyxel.btnp(pyxel.KEY_SPACE) or pyxel.btnp(pyxel.KEY_RETURN):
        if ball_attached:
            launch_ball()

    if pyxel.btnp(pyxel.KEY_R):
        reset()

    if ball_attached:
        ball_x = paddle_x + paddle_w / 2
        ball_y = paddle_y - 4
        return

    ball_speed = min(MAX_BALL_SPEED, ball_speed + 0.002)
    ball_x += ball_dx * ball_speed * 1.7
    ball_y += ball_dy * ball_speed * 1.7

    # Wall collision
    if ball_x <= 2:
        ball_x = 2
        ball_dx = abs(ball_dx)
    elif ball_x >= WIDTH - 2:
        ball_x = WIDTH - 2
        ball_dx = -abs(ball_dx)

    if ball_y <= 14:
        ball_y = 14
        ball_dy = abs(ball_dy)

    # Paddle collision
    paddle_left = paddle_x
    paddle_right = paddle_x + paddle_w
    paddle_top = paddle_y
    paddle_bottom = paddle_y + 5

    if paddle_top <= ball_y <= paddle_bottom and paddle_left <= ball_x <= paddle_right and ball_dy > 0:
        offset = (ball_x - (paddle_x + paddle_w / 2)) / (paddle_w / 2)
        ball_dx = offset * 1.2
        ball_dy = -abs(ball_dy)
        award_hit()

    # Bottom miss
    if ball_y >= HEIGHT - 2:
        lose_heart()
        if not game_over:
            ball_attached = True
            ball_x = paddle_x + paddle_w / 2
            ball_y = paddle_y - 4
            ball_dx = 0.0
            ball_dy = -1.0

    if game_over:
        if pyxel.btnp(pyxel.KEY_SPACE) or pyxel.btnp(pyxel.KEY_RETURN):
            reset()


pyxel.run(update, draw)

